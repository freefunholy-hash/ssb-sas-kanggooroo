type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PositionDistribution = 
 record {
   df: nat;
   fw: nat;
   gk: nat;
   mf: nat;
 };
type Position = 
 variant {
   DF;
   FW;
   GK;
   MF;
 };
type PlayerUpdate = 
 record {
   alamat: opt text;
   dokumen: opt vec Document;
   foto: opt FileReference;
   kontak: opt text;
   namaLengkap: opt text;
   nisn: opt text;
   nomorPunggung: opt nat;
   posisi: opt Position;
   riwayatMedis: opt MedicalRecord;
   statistik: opt PlayerStats;
   tanggalLahir: opt text;
 };
type PlayerStatsSummary = 
 record {
   distribusi: PositionDistribution;
   totalPemain: nat;
 };
type PlayerStats = 
 record {
   assist: nat;
   gol: nat;
   pertandingan: nat;
 };
type PlayerInput = 
 record {
   alamat: text;
   dokumen: vec Document;
   foto: FileReference;
   kontak: text;
   namaLengkap: text;
   nisn: text;
   nomorPunggung: nat;
   posisi: Position;
   riwayatMedis: MedicalRecord;
   statistik: PlayerStats;
   tanggalLahir: text;
 };
type Player = 
 record {
   alamat: text;
   dokumen: vec Document;
   foto: FileReference;
   id: nat;
   kontak: text;
   namaLengkap: text;
   nisn: text;
   nomorPunggung: nat;
   posisi: Position;
   riwayatMedis: MedicalRecord;
   statistik: PlayerStats;
   tanggalLahir: text;
   timestamp: Timestamp;
 };
type MedicalRecord = 
 record {
   alergi: text;
   golonganDarah: text;
   kondisiKhusus: text;
   riwayatCedera: text;
 };
type FileReference = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DocumentType = 
 variant {
   Akta;
   Ijazah;
   KK;
 };
type Document = 
 record {
   fileName: text;
   fileReference: FileReference;
   tipe: DocumentType;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  __accessControlState: () -> (reserved) query;
  __nextId: () -> (reserved) query;
  __players: () -> (reserved) query;
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addPlayer: (input: PlayerInput) -> (nat);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  deletePlayer: (id: nat) -> (bool);
  execute: (qJson: text) -> (Result) query;
  filterPlayers: (position: Position) -> (vec Player) query;
  generatePlayerPDF: (id: nat) -> (blob);
  getCallerUserRole: () -> (UserRole) query;
  getPlayer: (id: nat) -> (opt Player) query;
  getPlayerStats: () -> (PlayerStatsSummary) query;
  getPlayers: () -> (vec Player) query;
  isCallerAdmin: () -> (bool) query;
  schema: () -> (text) query;
  searchPlayers: (searchQuery: text) -> (vec Player) query;
  updatePlayer: (id: nat, update: PlayerUpdate) -> (opt Player);
}
